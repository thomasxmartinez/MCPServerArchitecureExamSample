{
    "mcpServers": {
        "filesystem": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-filesystem@2.4.0", "."],
            "type": "stdio"
        },
        "github": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-github"],
            "env": {"GITHUB_TOKEN": "${GITHUB_TOKEN}"},
            "type": "stdio"
        },
       "summarizer": {
           "command": "uv",
           "args": ["run", "--with", "mcp<2", "summarizer_server.py"],
           "type": "stdio"
       }
    }
}